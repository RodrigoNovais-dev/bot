# ====================================================================
# Configuração da OpenAI para o comando !criarskin
# Obtenha sua chave em: https://platform.openai.com/api-keys
# Copie este arquivo para ".env" e substitua o valor abaixo pela sua chave real.
# ====================================================================
OPENAI_API_KEY=sua_chave_aqui

# ---- Modelos da OpenAI (opcional — já possui padrões atualizados) ----
# Modelo multimodal para análise do texto/imagem (Responses API):
# OPENAI_VISION_MODEL=gpt-5.4-mini
# OPENAI_VISION_FALLBACK_MODELS=gpt-5-mini,gpt-4.1-mini
#
# Modelo de geração/edição de imagem (Image API /images/edits):
# Obs.: gpt-image-1 foi desativado em 23/10/2026; use gpt-image-2.5-sunburst ou gpt-image-2.5-flare.
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_FALLBACK_MODELS=gpt-image-2.5-flare,gpt-image-2
# OPENAI_IMAGE_QUALITY=medium

# ---- Opções da textura e pacote .mcpack (opcional) ----
# SKIN_PALETTE_COLORS=32
# SKIN_CONCEPT_ATTEMPTS=2
# SKIN_ALLOW_PROCEDURAL_FALLBACK=true
# SKIN_EXPORT_MCPACK=true
# SKIN_KEEP_FILES=false

# ---- Limites de desempenho e segurança (opcional) ----
# SKIN_MAX_IMAGE_MB=8
# SKIN_MAX_IMAGE_DIMENSION=8000
# SKIN_MAX_PROMPT_LENGTH=500
# SKIN_MAX_CONCURRENT=2
# SKIN_MAX_QUEUE=10
# SKIN_COOLDOWN_SECONDS=60
# SKIN_DAILY_LIMIT=10
# SKIN_TIMEOUT_SECONDS=240
# OPENAI_REQUEST_TIMEOUT_SECONDS=180
# SKIN_RECENT_IMAGE_TTL_SECONDS=600
# SKIN_ADMIN_NUMBERS=
